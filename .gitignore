node_modules/
dist/
dist-lending-regtest/
*.zip
.DS_Store
*.log
.vite/
.pnpm-store/
playwright-report/
test-results/
target/

# local-only env (enterprise API credentials for dev/test) — never commit
.env.local
.env*.local
.env
.env.production

# local release artifacts (zips live on GitHub Releases)
releases/

# scratch credential files staged by hand — never commit, whatever they get named.
# The .env rules above only catch the names Vite loads; a key pasted into a file
# while testing rarely gets one of those.
.temp-*
*.key

# Local-only planning material. This repo is PUBLIC, and product/commercial
# documents live in the working tree while they are being worked on, so the
# rules below are committed rather than left in .git/info/exclude — an exclude
# file is per-machine and does not survive a fresh clone, which is precisely
# when someone else would run `git add -A` over a docs/ directory they did not
# put there. Filenames are matched by pattern so a new document is covered on
# arrival instead of after someone remembers to add it.
docs/local/
# Both depths: `*` does not cross `/`, so the single-star form alone would miss
# docs/planning/PRD.md.
docs/*PRD*
docs/*prd*
docs/**/*PRD*
docs/**/*prd*
