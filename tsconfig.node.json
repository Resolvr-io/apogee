{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vite.playground.config.ts",
    "playwright.config.ts",
    "playwright.lending-regtest.config.ts",
    "manifest.config.ts",
    "manifest.shared.ts",
    "scripts/build-firefox.ts",
    "e2e/**/*.ts"
  ]
}
